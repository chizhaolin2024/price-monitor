# PriceWatch configuration
# How often the background checker runs (seconds). Default: hourly.
CHECK_INTERVAL_SECONDS=3600

# Telegram alerts (leave empty to disable; alerts fall back to the console log)
# Create a bot via @BotFather, then put your chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email alerts via SMTP (leave empty to disable)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# SQLite database location (default: backend/data/pricewatch.db)
# DB_PATH=/data/pricewatch.db
